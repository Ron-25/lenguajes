// Algunos casos poco comunes que FlowLang acepta.
inicio
    /*** comentario de bloque con asteriscos ***/
    /**/
    numero _ = 0;
    numero identificador_de_32_caracteres__ = 007;
    numero si2 = 1; // Aunque empieza por "si", sigue siendo un identificador.
    numero Inicio = 2; // Las mayúsculas cambian el nombre: Inicio no es inicio.
    texto vacia = "";
    texto escapes = "comilla \" barra \\ salto \n tab \t";
    texto no_es_comentario = "Texto normal: // y /* esto no abre comentarios */";
    decimal d = 0.0;
    booleano b = verdadero;
    // Los operadores también se reconocen cuando van juntos.
    b = si2>=_&&si2<=Inicio||!b==falso!=verdadero;
    d = d+1.5-2*3/4%5;
    mientras(si2<3){si2=si2+1;}
    si (b) { mostrar(vacia, escapes); } sino { esperar 1; }
    // La unidad va pegada al número.
    esperar 500ms; esperar 10s; esperar 5m; esperar 2h; esperar 007s;
    esperar 3 s; // Con espacio, 3 y s se leen por separado.
fin
// También se acepta un comentario al final del archivo.
