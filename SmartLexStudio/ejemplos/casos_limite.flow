// Casos limite: todo este archivo es VALIDO (0 diagnosticos)
inicio
    /*** comentario de bloque con asteriscos ***/
    /**/
    numero _ = 0;
    numero identificador_de_32_caracteres__ = 007;
    numero si2 = 1; // 'si2' es identificador, no la palabra reservada 'si'
    numero Inicio = 2; // FlowLang distingue mayusculas: 'Inicio' es identificador
    texto vacia = "";
    texto escapes = "comilla \" barra \\ salto \n tab \t";
    texto no_es_comentario = "// esto es una cadena /* y esto tambien */";
    decimal d = 0.0;
    booleano b = verdadero;
    // Coincidencia mas larga (maximal munch) sin espacios:
    b = si2>=_&&si2<=Inicio||!b==falso!=verdadero;
    d = d+1.5-2*3/4%5;
    mientras(si2<3){si2=si2+1;}
    si (b) { mostrar(vacia, escapes); } sino { esperar 1; }
fin
// comentario final sin salto de linea