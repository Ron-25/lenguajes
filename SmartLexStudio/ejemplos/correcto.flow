// Control sencillo del riego en un invernadero.
inicio
    /* Datos que vamos a usar:
       temperatura, humedad y bomba */
    numero temperatura = 28;
    decimal humedad = 45.5;
    texto zona = "Invernadero \"Norte\"";
    booleano activo = verdadero;
    dispositivo bomba;
    numero ciclos = 0;

    leer temperatura;
    si (temperatura >= 30 && humedad < 50.0) {
        activar bomba;
        esperar 30s;
        mostrar "Regando: " + zona;
    } sino {
        desactivar bomba;
    }

    mientras (activo == verdadero && ciclos < 3) {
        ciclos = ciclos + 1;
        humedad = humedad * 1.05 - 2 % 3;
        si (!activo || ciclos != 3) {
            mostrar "Ciclo\t" + zona;
        }
    }
    mostrar "Fin del riego\n";
fin
