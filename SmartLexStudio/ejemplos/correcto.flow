// Riego automatico de un invernadero (programa FlowLang 2.0 valido)
Algoritmo riego_invernadero
    /* Declaraciones: un Definir admite
       varios nombres separados por comas */
    Definir temperatura, humedad Como Real;
    Definir ciclos, zona Como Entero;
    Definir nombre Como Cadena;
    Definir activo Como Logico;
    Definir bomba, ventilador Como Dispositivo;

    nombre <- "Invernadero \"Norte\"";
    activo <- Verdadero;
    ciclos <- 0;
    Escribir "Zona (1 a 3): ";
    Leer zona;
    Leer temperatura, humedad;

    Si temperatura >= 30C Y humedad < 40% Entonces
        Activar bomba;
        Esperar 10s;
        Escribir "Regando: ", nombre;
    SiNo
        Desactivar bomba;
    FinSi

    Mientras activo = Verdadero Y ciclos < 3 Hacer
        ciclos <- ciclos + 1;
        humedad <- humedad * 1.05 - 2 ^ 2 / 4;
        Si NO activo O ciclos MOD 2 <> 0 Entonces
            Escribir "Ciclo\t", ciclos;
        FinSi
    FinMientras

    Para i <- 1 Hasta 10 Con Paso 2 Hacer
        Activar ventilador;
        Esperar 500ms;
        Desactivar ventilador;
    FinPara

    Repetir
        Leer temperatura;
        Esperar 1.5m;
    Hasta Que temperatura <= 22.5C

    Segun zona Hacer
        Caso 1:
            Esperar 5m;
        Caso 2, 3:
            Esperar 1h;
        De Otro Modo:
            Escribir "Zona desconocida\n";
    FinSegun
    escribir "Fin del riego";   // las palabras reservadas no distinguen mayusculas
FinAlgoritmo
